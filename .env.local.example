# =============================================================================
# Avenue Eyewear — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to version control.
# =============================================================================

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Example (local):   postgresql://postgres:secret@localhost:5432/avenue_eyewear
# Example (Supabase): postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres
# Example (Neon):    postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/avenue_eyewear

# Apify API token
# Get it from: https://console.apify.com/account/integrations
APIFY_API_TOKEN=your_apify_api_token_here

# The full Google Maps URL for Avenue Eyewear's listing
# Find it by searching the business on Google Maps and copying the URL
# It should look like: https://www.google.com/maps/place/Avenue+Eyewear/@40.4305742,-74.2539434,...
GOOGLE_MAPS_URL=https://www.google.com/maps/place/Avenue+Eyewear/@40.4305742,-74.2539434,17z
